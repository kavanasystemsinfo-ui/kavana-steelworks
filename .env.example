# KAVANA Steelworks — variables de entorno del backend.
# Copia a `.env` para desarrollo local, o usa `fly secrets set` en producción.
# NUNCA commitees valores reales.

# Base de datos (Fly/Neon/Render entregan postgres:// y se normaliza solo).
# OBLIGATORIA en producción; en desarrollo hay un default localhost.
STEELWORKS_DATABASE_URL=postgresql+psycopg://<usuario>:<contraseña>@<host>:5432/kavana_steelworks

# Secreto de firma JWT. OBLIGATORIO en producción (>= 32 caracteres, 256 bits).
# La app falla al arrancar si production no lo tiene (fail-fast).
# Genera con: openssl rand -hex 32
STEELWORKS_JWT_SECRET=

# Entorno: development | production
STEELWORKS_ENVIRONMENT=development
